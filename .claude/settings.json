{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"rules": [
					{
						"name": "forbid-npm",
						"description": "Block npm/pnpm/yarn (use bun only)",
						"pattern": "^(npm|pnpm|yarn)(\\s|$)",
						"action": "deny",
						"reason": "This project uses bun exclusively. Use 'bun' instead."
					},
					{
						"name": "autoapprove-safe",
						"description": "Auto-approve safe commands",
						"patterns": [
							"^bun fix$",
							"^bun fix ",
							"^bun run test",
							"^bun tsc",
							"^bun build-ci$"
						],
						"action": "allow",
						"reason": "Auto-approved safe command"
					}
				]
			},
			{
				"matcher": "Edit|Write",
				"rules": [
					{
						"name": "forbid-generated",
						"description": "Block edits to auto-generated files",
						"patterns": [
							"src/routeTree\\.gen\\.ts$",
							"convex/_generated/",
							"\\.generated\\."
						],
						"action": "deny",
						"reason": "Auto-generated files should not be edited manually. Run 'bun run build-ci' to regenerate."
					},
					{
						"name": "forbid-sensitive",
						"description": "Block edits to sensitive files",
						"patterns": [
							"\\.git/",
							"\\.git$",
							"\\.env\\.local$",
							"\\.gitignore$",
							"\\.wrangler/"
						],
						"action": "deny",
						"reason": "Sensitive files should not be edited by agents."
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "cd \"$CLAUDE_PROJECT_DIR\" && bun run format",
						"async": true,
						"timeout": 30,
						"statusMessage": "Running format..."
					}
				]
			}
		]
	}
}
